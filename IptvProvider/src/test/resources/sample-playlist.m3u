#EXTM3U x-tvg-url="https://example.com/epg.xml"

#EXTINF:-1 tvg-id="BBCOne.uk" tvg-logo="https://example.com/bbc1.png" group-title="United Kingdom",BBC One
https://example.com/bbcone/index.m3u8

#EXTINF:-1 tvg-id="CNN.us" tvg-logo="https://example.com/cnn.png" group-title="News, Politics" tvg-country="US" tvg-language="English",CNN International
https://example.com/cnn/index.m3u8

# Comma inside group-title above is the main trap: a naive split on the first
# comma truncates the attributes and loses the display name.

#EXTINF:-1 tvg-id="NHK.jp" tvg-name="NHK World" group-title="Japan",
https://example.com/nhk/index.m3u8

# Blank display name above: the name must fall back to tvg-name.

#EXTINF:-1 tvg-id="Arte.fr" group-title="France",Arte
#EXTVLCOPT:http-user-agent=Mozilla/5.0
#KODIPROP:inputstream.adaptive.manifest_type=hls
https://example.com/arte/index.m3u8

# Extra directives between #EXTINF and the URL above must be skipped without
# discarding the pending entry.

#EXTINF:-1 tvg-id="Orphan.xx" group-title="Broken",Orphaned Entry
#EXTINF:-1 tvg-id="Recovered.xx" group-title="Broken",Recovered Entry
https://example.com/recovered/index.m3u8

# The orphan above has no URL. It should be dropped, and parsing should recover
# cleanly enough that the entry after it still comes through.

#EXTINF:-1 tvg-id="NoName.xx" group-title="Broken",
https://example.com/noname/index.m3u8

# No display name and no tvg-name: unusable, must be skipped.

https://example.com/stray/index.m3u8

# A URL with no preceding #EXTINF has no metadata and must be skipped.

#EXTINF:-1 tvg-id="Last.xx" group-title="Final",Last Channel
https://example.com/last/index.m3u8
